{
  "name": "scrcpy-manager-vue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:web": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "vue-tsc --noEmit",
    "electron:dev": "electron-vite dev",
    "electron:build": "vue-tsc -b && electron-vite build",
    "electron:preview": "electron-vite preview",
    "electron:pack": "pnpm electron:build && electron-builder --dir",
    "electron:dist": "pnpm electron:build && electron-builder",
    "dev:full": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "backend:start": "powershell -ExecutionPolicy Bypass -File scripts/start-backend.ps1",
    "backend:check": "powershell -ExecutionPolicy Bypass -File scripts/check-api.ps1",
    "tools:check": "powershell -ExecutionPolicy Bypass -File scripts/check-backend.ps1",
    "api:publish": "powershell -ExecutionPolicy Bypass -File scripts/publish-api.ps1",
    "dist": "powershell -ExecutionPolicy Bypass -File scripts/build-dist.ps1",
    "dist:skip-api": "powershell -ExecutionPolicy Bypass -File scripts/build-dist.ps1 -SkipApi",
    "dist:quick": "powershell -ExecutionPolicy Bypass -File scripts/build-dist.ps1 -SkipApi -SkipBuild"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@microsoft/signalr": "^10.0.0",
    "axios": "^1.11.0",
    "koffi": "^2.16.1",
    "vue": "^3.5.17",
    "vuetify": "3.9.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@types/node": "^24.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "sass-embedded": "^1.99.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vue-tsc": "^2.2.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "app-builder-bin",
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
